# Copy to jobs/.env for local runs, or add these as GitHub repository secrets.
# Leave DATABASE_URL empty to save to jobs/.data/ instead of Supabase.

FPL_TEAM_ID=11304359
# From Supabase: Project Settings > Database > Connection string (URI).
DATABASE_URL=
# Optional: mini-league ids to analyse, comma separated. Empty picks your smallest private leagues.
SQUADSENSE_LEAGUES=
