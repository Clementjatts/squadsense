# Copy this file to .env.local and fill in the values.
# Leave the Supabase lines empty to run in demo mode with sample data.

# Your FPL team ID (the number in the URL of your Points page).
FPL_TEAM_ID=11304359

# From Supabase: Project Settings > API. The service role key can read
# everything, so it must only ever live in this file or in Vercel's
# environment settings. Never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
