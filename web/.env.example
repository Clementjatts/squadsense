# Copy this file to .env.local and fill in the values.
# Leave the Supabase lines empty to run in demo mode with sample data.

# Your FPL team ID (the number in the URL of your Points page).
FPL_TEAM_ID=11304359

# From Supabase: Project Settings > API. The service role key can read
# everything, so it must only ever live in this file or in Vercel's
# environment settings. Never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard login: the password you sign in with, and a long random
# string (at least 32 characters) that signs the login cookie. Generate
# one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SITE_PASSWORD=
SITE_SECRET=

# Optional, this Mac only: your FPL sign-in, used by the Planner's "Apply to FPL".
# Never put these on Vercel.
FPL_EMAIL=
FPL_PASSWORD=
